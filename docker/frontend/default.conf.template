worker_processes auto;
pid /tmp/nginx.pid;
events {}

http {
    include /etc/nginx/mime.types;
    default_type text/plain;
    client_max_body_size ${LANGFLOW_MAX_FILE_SIZE_UPLOAD}M;

    types {
        text/html html;
        text/css css;
        application/javascript js;
    }

    server {
        gzip off;
        gzip_comp_level 2;
        gzip_min_length 1000;
        gzip_types text/xml text/css;
        gzip_http_version 1.1;
        gzip_vary on;
        gzip_disable "MSIE [4-6] \.";

        keepalive_timeout 3600s;
        keepalive_requests 1000;
        send_timeout 3600s;

        client_body_timeout 3600s;
        client_header_timeout 3600s;

        listen ${FRONTEND_PORT};

        location / {
            root /usr/share/nginx/html;
            index index.html index.htm;
            try_files $uri $uri/ /index.html =404;
            expires 1d;
            add_header Cache-Control "public";
        }
        location = /index.html {
            root /usr/share/nginx/html;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            etag on;
        }

        location /api {
            proxy_buffering off;                    # 禁用缓冲，立即传输数据
            proxy_request_buffering off;            # 禁用请求缓冲
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_set_header X-Accel-Buffering no;  # 完全禁用加速缓冲
            proxy_set_header Cache-Control "no-cache, no-store, must-revalidate";
            proxy_pass ${BACKEND_URL};
        }
        location /health_check {
            proxy_pass ${BACKEND_URL};
        }
        location /health {
            proxy_pass ${BACKEND_URL};
        }
        location ^~ /data-api {
            proxy_pass ${DATA_API_URL};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            rewrite ^/data-api/(.*)$ /$1 break;
        }

        include /etc/nginx/extra-conf.d/*.conf;
    }
}