# Description: Example of .env file
# Usage: Copy this file to .env and change the values
#        according to your needs
#        Do not commit .env file to git
#        Do not change .env.example file

# Config directory
# Directory where files, logs and database will be stored
# Example: LANGFLOW_CONFIG_DIR=~/.langflow
LANGFLOW_CONFIG_DIR=

# Save database in the config directory
# Values: true, false
# If false, the database will be saved in Langflow's root directory
# This means that the database will be deleted when Langflow is uninstalled
# and that the database will not be shared between different virtual environments
# Example: LANGFLOW_SAVE_DB_IN_CONFIG_DIR=true
LANGFLOW_SAVE_DB_IN_CONFIG_DIR=

# Database URL
# Postgres example: LANGFLOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langflow
# SQLite example:
LANGFLOW_DATABASE_URL=sqlite:///./langflow.db

# Database connection retry
# Values: true, false
# If true, the database will retry to connect to the database if it fails
# Example: LANGFLOW_DATABASE_CONNECTION_RETRY=true
LANGFLOW_DATABASE_CONNECTION_RETRY=false

# Cache type
LANGFLOW_LANGCHAIN_CACHE=SQLiteCache

# Server host
# Example: LANGFLOW_HOST=localhost
LANGFLOW_HOST=

# Worker processes
# Example: LANGFLOW_WORKERS=1
LANGFLOW_WORKERS=

# Server port
# Example: LANGFLOW_PORT=7860
LANGFLOW_PORT=

# Logging level
# Example: LANGFLOW_LOG_LEVEL=critical
LANGFLOW_LOG_LEVEL=

# Path to the log file
# Example: LANGFLOW_LOG_FILE=logs/langflow.log
LANGFLOW_LOG_FILE=

# Time/Size for log to rotate
# Example: LANGFLOW_LOG_ROTATION=‘10 MB’/‘1 day’
LANGFLOW_LOG_ROTATION=

# Path to the frontend directory containing build files
# Example: LANGFLOW_FRONTEND_PATH=/path/to/frontend/build/files
LANGFLOW_FRONTEND_PATH=

# Whether to open the browser after starting the server
# Values: true, false
# Example: LANGFLOW_OPEN_BROWSER=true
LANGFLOW_OPEN_BROWSER=

# Whether to remove API keys from the projects saved in the database
# Values: true, false
# Example: LANGFLOW_REMOVE_API_KEYS=false
LANGFLOW_REMOVE_API_KEYS=

# Whether to use RedisCache or ThreadingInMemoryCache or AsyncInMemoryCache
# Values: async, memory, redis
# Example: LANGFLOW_CACHE_TYPE=memory
# If you want to use redis then the following environment variables must be set:
# LANGFLOW_REDIS_HOST (default: localhost)
# LANGFLOW_REDIS_PORT (default: 6379)
# LANGFLOW_REDIS_DB (default: 0)
# LANGFLOW_REDIS_CACHE_EXPIRE (default: 3600)
LANGFLOW_CACHE_TYPE=

# Set LANGFLOW_AUTO_LOGIN to false if you want to disable auto login
# and use the login form to login. LANGFLOW_SUPERUSER and LANGFLOW_SUPERUSER_PASSWORD
# must be set if AUTO_LOGIN is set to false
# Values: true, false
LANGFLOW_AUTO_LOGIN=

# SET LANGFLOW_ENABLE_SUPERUSER_CLI to false to disable
# superuser creation via the CLI
LANGFLOW_ENABLE_SUPERUSER_CLI=

# Superuser username
# Example: LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER=

# Superuser password
# Example: LANGFLOW_SUPERUSER_PASSWORD=123456
LANGFLOW_SUPERUSER_PASSWORD=

# Should store environment variables in the database
# Values: true, false
LANGFLOW_STORE_ENVIRONMENT_VARIABLES=

# Should enable the MCP composer feature in MCP projects
# Values: true, false
# Default: true
LANGFLOW_MCP_COMPOSER_ENABLED=

# STORE_URL
# Example: LANGFLOW_STORE_URL=https://api.langflow.store
# LANGFLOW_STORE_URL=

# DOWNLOAD_WEBHOOK_URL
#
# LANGFLOW_DOWNLOAD_WEBHOOK_URL=

# LIKE_WEBHOOK_URL
#
# LANGFLOW_LIKE_WEBHOOK_URL=

# Value must finish with slash /
#BACKEND_URL=http://localhost:7860/
BACKEND_URL=

# ==============================================================================
# Nacos Configuration
# ==============================================================================

# Enable Nacos integration
# Values: true, false
# Example: LANGFLOW_NACOS_ENABLED=true
LANGFLOW_NACOS_ENABLED=false

# Nacos server addresses (comma-separated for multiple servers)
# Example: NACOS_SERVER_ADDRESSES=localhost:8848
# Example (cluster): NACOS_SERVER_ADDRESSES=nacos1:8848,nacos2:8848,nacos3:8848
NACOS_SERVER_ADDRESSES=localhost:8848

# Nacos namespace ID
# Use different namespaces for different environments (dev/test/prod)
# Example: NACOS_NAMESPACE=langflow-prod
NACOS_NAMESPACE=public

# Nacos authentication
# Example: NACOS_USERNAME=nacos
NACOS_USERNAME=

# Example: NACOS_PASSWORD=nacos
NACOS_PASSWORD=

# Enable service registration
# Values: true, false
# If true, Langflow will register itself as a service in Nacos
# Example: LANGFLOW_NACOS_SERVICE_REGISTRATION_ENABLED=true
LANGFLOW_NACOS_SERVICE_REGISTRATION_ENABLED=false

# Service name for registration
# Example: LANGFLOW_NACOS_SERVICE_NAME=langflow-api
LANGFLOW_NACOS_SERVICE_NAME=langflow

# Service IP for registration (leave empty to auto-detect)
# Example: LANGFLOW_NACOS_SERVICE_IP=192.168.1.100
LANGFLOW_NACOS_SERVICE_IP=

# Service port for registration (should match LANGFLOW_PORT)
# Example: LANGFLOW_NACOS_SERVICE_PORT=7860
LANGFLOW_NACOS_SERVICE_PORT=7860

# Service metadata (JSON format)
# Example: LANGFLOW_NACOS_SERVICE_METADATA={"version":"1.0.0","region":"us-west-1"}
LANGFLOW_NACOS_SERVICE_METADATA={}

# ==============================================================================
# Holo Knowledge System Configuration
# ==============================================================================

# OAuth - Google (for Google Calendar and Gmail connectors)
# LANGFLOW_GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
# LANGFLOW_GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
# LANGFLOW_GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:7860/api/v1/oauth/google-calendar/callback
# LANGFLOW_GOOGLE_GMAIL_REDIRECT_URI=http://localhost:7860/api/v1/oauth/google-gmail/callback

# OAuth - Airtable
# LANGFLOW_AIRTABLE_CLIENT_ID=your-airtable-client-id
# LANGFLOW_AIRTABLE_CLIENT_SECRET=your-airtable-client-secret
# LANGFLOW_AIRTABLE_REDIRECT_URI=http://localhost:7860/api/v1/oauth/airtable/callback

# Embedding Configuration
# Model name for embeddings (OpenAI, Azure, etc.)
# LANGFLOW_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI (if using Azure for embeddings)
# LANGFLOW_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# LANGFLOW_AZURE_OPENAI_API_KEY=your-azure-api-key

# Chunking Configuration
# LANGFLOW_CHUNK_SIZE=512
# LANGFLOW_CHUNK_OVERLAP=128

# Reranking Configuration
# Enable reranking of search results
# LANGFLOW_RERANKERS_ENABLED=false
# LANGFLOW_RERANKERS_MODEL_NAME=flashrank
# LANGFLOW_RERANKERS_MODEL_TYPE=local

# ETL Service Configuration
# ETL service type: UNSTRUCTURED or LLAMACLOUD
# LANGFLOW_ETL_SERVICE=UNSTRUCTURED
# ETL fallback service: DOCILING when primary fails
# LANGFLOW_ETL_FALLBACK_SERVICE=docling
# ETL chunking overrides (if different from global chunking)
# LANGFLOW_ETL_CHUNK_SIZE=512
# LANGFLOW_ETL_CHUNK_OVERLAP=128
# Default page limit for new users
# LANGFLOW_PAGES_LIMIT=999999999
# LANGFLOW_UNSTRUCTURED_API_KEY=your-unstructured-api-key
# LANGFLOW_LLAMA_CLOUD_API_KEY=your-llamacloud-api-key

# ==============================================================================
# Vector Store Configuration
# ==============================================================================

# Vector engine selection: chroma, milvus, sqlite_vec, qdrant, weaviate
# LANGFLOW_VECTOR_ENGINE_TYPE=chroma

# Chroma configuration
# LANGFLOW_VECTOR_CHROMA_PERSIST_DIRECTORY=./chroma_db
# LANGFLOW_VECTOR_CHROMA_HOST=
# LANGFLOW_VECTOR_CHROMA_PORT=

# Milvus configuration
# Use a file path for Milvus Lite (e.g. ./data/lightrag/milvus_lite.db)
# LANGFLOW_VECTOR_MILVUS_HOST=localhost
# LANGFLOW_VECTOR_MILVUS_PORT=19530
# LANGFLOW_VECTOR_MILVUS_USER=
# LANGFLOW_VECTOR_MILVUS_PASSWORD=
# LANGFLOW_VECTOR_MILVUS_DB_NAME=default

# sqlite-vec configuration
# LANGFLOW_VECTOR_SQLITE_VEC_DATABASE_PATH=./vectors.db

# Qdrant configuration
# LANGFLOW_VECTOR_QDRANT_HOST=localhost
# LANGFLOW_VECTOR_QDRANT_PORT=6333
# LANGFLOW_VECTOR_QDRANT_API_KEY=

# Weaviate configuration
# LANGFLOW_VECTOR_WEAVIATE_URL=http://localhost:8080
# LANGFLOW_VECTOR_WEAVIATE_API_KEY=

# Text-to-Speech Configuration
# LANGFLOW_TTS_SERVICE=kokoro
# LANGFLOW_TTS_SERVICE_API_BASE=http://localhost:8000
# LANGFLOW_TTS_SERVICE_API_KEY=your-tts-api-key

# Speech-to-Text Configuration
# LANGFLOW_STT_SERVICE=faster-whisper

# ==============================================================================
# Knowledge Graph Configuration (LightRAG + Neo4j)
# ==============================================================================

# Enable Knowledge Graph
# LANGFLOW_KG_ENABLED=true

# LightRAG Working Directory
# LANGFLOW_KG_WORKING_DIR=./data/lightrag

# Unified LLM Configuration (shared by ETL + KG)
# LANGFLOW_LLM_API_KEY=
# LANGFLOW_LLM_BASE_URL=
# LANGFLOW_LLM_LLM_MODEL=gpt-4o-mini
# LANGFLOW_LLM_LLM_MAX_ASYNC=4
# LANGFLOW_LLM_EMBEDDING_MODEL=openai
# LANGFLOW_LLM_EMBEDDING_DIMENSION=1536
# LANGFLOW_LLM_EMBEDDING_BATCH_SIZE=32
# LANGFLOW_LLM_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LANGFLOW_LLM_COHERE_API_KEY=
# LANGFLOW_LLM_COHERE_EMBEDDING_MODEL=embed-english-v3.0
# LANGFLOW_LLM_SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
# LANGFLOW_LLM_SENTENCE_TRANSFORMER_DEVICE=cpu

# Knowledge Graph LLM Overrides (optional, prefer LANGFLOW_LLM_*)
# LANGFLOW_KG_LLM_MODEL=gpt-4o-mini
# LANGFLOW_KG_LLM_API_KEY=
# LANGFLOW_KG_LLM_BASE_URL=
# LANGFLOW_KG_LLM_MAX_ASYNC=4

# Knowledge Graph Embedding Overrides (optional, prefer LANGFLOW_LLM_*)
# LANGFLOW_KG_EMBEDDING_MODEL=openai
# LANGFLOW_KG_EMBEDDING_API_KEY=
# LANGFLOW_KG_EMBEDDING_DIMENSION=1536
# LANGFLOW_KG_EMBEDDING_BATCH_NUM=32

# Neo4j Configuration
# LANGFLOW_KG_NEO4J_ENABLED=true
# LANGFLOW_KG_NEO4J_URI=bolt://localhost:7687
# LANGFLOW_KG_NEO4J_USERNAME=neo4j
# LANGFLOW_KG_NEO4J_PASSWORD=
# LANGFLOW_KG_NEO4J_DATABASE=neo4j
# NEO4J_PASSWORD=your_neo4j_password

# Milvus Configuration (optional)
# LANGFLOW_KG_MILVUS_ENABLED=true
# LANGFLOW_KG_MILVUS_HOST=localhost
# LANGFLOW_KG_MILVUS_PORT=19530
# LANGFLOW_KG_MILVUS_USER=
# LANGFLOW_KG_MILVUS_PASSWORD=
# LANGFLOW_KG_USE_MILVUS=false
# MILVUS_URI=http://localhost:19530
# MILVUS_DB_NAME=default

# Graph Retrieval Configuration
# LANGFLOW_KG_GRAPH_RELATION_TYPES=
# LANGFLOW_KG_GRAPH_RECALL_LIMIT=50
# LANGFLOW_KG_GRAPH_RRF_WEIGHT=1.0

# Extraction Configuration
# LANGFLOW_KG_EXTRACT_ENTITIES=true
# LANGFLOW_KG_EXTRACT_RELATIONS=true
# LANGFLOW_KG_MAX_ENTITIES_PER_DOCUMENT=100
# LANGFLOW_KG_MAX_RELATIONS_PER_DOCUMENT=100

# Query Configuration
# LANGFLOW_KG_DEFAULT_QUERY_MODE=hybrid
# LANGFLOW_KG_DEFAULT_TOP_K=10
# LANGFLOW_STT_SERVICE_API_BASE=http://localhost:8000
# LANGFLOW_STT_SERVICE_API_KEY=your-stt-api-key

# Global LLM Configuration
# Path to YAML file with global LLM configurations
# LANGFLOW_GLOBAL_LLM_CONFIG_PATH=/path/to/global_llm_config.yaml
